@inject UserManager<ApplicationUser> UserManager
@{
    var current = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
    var isSeeker = User.IsInRole(Roles.Seeker);
    var isEmployer = User.IsInRole(Roles.Employer);
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JobBoard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">JobBoard</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto">
                @if (isSeeker)
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Seeker" asp-action="Index">Мой кабинет</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Vacancies" asp-action="Index">Вакансии</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Seeker" asp-action="Applications">Мои отклики</a></li>
                }
                @if (isEmployer)
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Resumes" asp-action="Catalog">Каталог резюме</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Vacancies" asp-action="Index">Вакансии</a></li>
                }
            </ul>
            <ul class="navbar-nav align-items-center">
                @if (current != null)
                {
                    <li class="nav-item d-flex align-items-center me-3">
                        <img src="@current.AvatarUrl" class="avatar avatar-sm me-2" alt="" />
                        <span class="text-white">@current.DisplayName</span>
                    </li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-outline-light btn-sm">Выйти</button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Войти</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Регистрация</a></li>
                }
            </ul>
        </div>
    </div>
</nav>
<div class="container pb-5">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @RenderBody()
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
