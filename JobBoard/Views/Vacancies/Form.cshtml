@model VacancyFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Редактирование вакансии" : "Новая вакансия";
}
<h3 class="mb-3">@ViewData["Title"]</h3>

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">Основная информация</div>
        <div class="card-body row g-3">
            <div class="col-md-6">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" maxlength="200" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                    <option value="">Выберите категорию</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Salary" class="form-label"></label>
                <input asp-for="Salary" class="form-control" type="number" min="0" step="1" />
                <span asp-validation-for="Salary" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">Требуемый опыт работы</div>
        <div class="card-body row g-3">
            <div class="col-md-3">
                <label asp-for="ExperienceFrom" class="form-label"></label>
                <input asp-for="ExperienceFrom" class="form-control" type="number" min="0" max="50" step="1" />
                <span asp-validation-for="ExperienceFrom" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="ExperienceTo" class="form-label"></label>
                <input asp-for="ExperienceTo" class="form-control" type="number" min="0" max="50" step="1" />
                <span asp-validation-for="ExperienceTo" class="text-danger small"></span>
            </div>
            <div class="col-12 text-muted small">Оставьте поле пустым, если ограничения нет.</div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">Описание</div>
        <div class="card-body row g-3">
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="6"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Requirements" class="form-label"></label>
                <textarea asp-for="Requirements" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Requirements" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Сохранить</button>
        <a class="btn btn-outline-secondary" asp-controller="Employer" asp-action="Index">Отмена</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
